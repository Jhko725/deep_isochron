clc
clear all

periodO = [];
strProb = './fncMultiSeg';
T       = -eye(2)*[cos(9.5), -sin(9.5);sin(9.5), cos(9.5)];
cMap    = cool(100);
figure(1); hold on;
for i=1:100
    p                 =  load([strProb '/dataIso/' strProb '_Iso_' num2str(i) '.csv']); 
    periodO(end+1,:)  =  (T*p(i,1:2)')';
    transCurve        =  (T*p(:,3:4)')';
    plot(transCurve(:,1),transCurve(:,2),'LineWidth',2,'Color',cMap(i,:))
end
periodO(end+1,:)  =  periodO(1,:);
plot(periodO(:,1),periodO(:,2),'LineWidth',1,'Color',[0,0,0])
axis([-2,2,-0.4,1.5])
%axis([0.83,1.03,-0.,-0.23])